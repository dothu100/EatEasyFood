<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EatEasyFood"
        tools:targetApi="31">
        <activity
            android:name="com.examples.eateasyfood.recentOrderItems"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.ChooseLocationActivity"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.PayOutActivity"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.SignActivity"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.LoginActivity"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.StartActivity"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.DetailsActivity"
            android:exported="false" />
        <activity
            android:name="com.examples.eateasyfood.Splash_Sreen"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
        <activity
            android:name="com.examples.eateasyfood.MainActivity"
            android:exported="true">

        </activity>
    </application>

</manifest>